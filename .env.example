# Copy to .env and fill in. Nothing here has a usable default on purpose.

# ---------------------------------------------------------------- database
POSTGRES_USER=clearcut
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clearcut
CLEARCUT_DATABASE_URL=postgresql+psycopg://clearcut:change-me@db:5432/clearcut

# ---------------------------------------------------------------- app
CLEARCUT_SEED_ON_STARTUP=true
# Where the frontend is served from. The API rejects browser requests from anywhere else.
CLEARCUT_CORS_ORIGINS=["https://clearcut.example.com"]
PUBLIC_API_BASE=https://api.clearcut.example.com
API_PORT=8000
WEB_PORT=3000

# ---------------------------------------------------------------- auth
# Higher is slower and safer; the cost is stored inside each hash, so it can change later.
CLEARCUT_BCRYPT_ROUNDS=12
CLEARCUT_SESSION_TTL_DAYS=14
# Set false to run a closed instance where an existing owner invites everyone.
CLEARCUT_ALLOW_OPEN_REGISTRATION=true

# ---------------------------------------------------------------- jobs and storage
CLEARCUT_USE_WORKER=true
CLEARCUT_REDIS_URL=redis://redis:6379
CLEARCUT_THUMBNAIL_CACHE_ENABLED=false

# ---------------------------------------------------------------- integrations
# Without this, script extraction and reply reading are disabled and everything else works.
CLEARCUT_ANTHROPIC_API_KEY=
CLEARCUT_YOUTUBE_API_KEY=

# ---------------------------------------------------------------- outreach and mail
CLEARCUT_PUBLIC_BASE_URL=https://api.clearcut.example.com
CLEARCUT_SENDER_NAME=Clearances
CLEARCUT_SENDER_EMAIL=clearances@clearcut.example.com
# console | postmark | sendgrid. `console` records sends without touching the network.
CLEARCUT_MAIL_PROVIDER=console
CLEARCUT_POSTMARK_SERVER_TOKEN=
CLEARCUT_INBOUND_DOMAIN=inbound.clearcut.example.com
# The signature is what makes an inbound webhook trustworthy. Do not leave this empty.
CLEARCUT_INBOUND_WEBHOOK_SECRET=
# Leave false unless you intend to email real licensing desks from this instance.
CLEARCUT_ALLOW_RESERVED_TLD_RECIPIENTS=false
# Human confirmation is the default; auto-apply never applies a change carrying money.
CLEARCUT_AUTO_APPLY_REPLIES=false
